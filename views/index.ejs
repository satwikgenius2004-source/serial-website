<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SERIAL — Men's Fashion</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="top-bar">
    Free shipping on orders over ₹999
</div>

<header class="header">

    <a href="/" class="logo">SERIAL</a>

    <nav class="nav">
        <a href="/shop">Shop</a>
        <a href="/shop">New Arrivals</a>
        <a href="/shop">Collections</a>
        <a href="/shop">Sale</a>
    </nav>

    <div class="header-actions">

        <button id="searchBtn" type="button">⌕</button>

        <a href="/login">Account</a>

        <button id="cartBtn" type="button">
            Bag (<span id="cartCount">0</span>)
        </button>

        <button id="menuBtn" class="menu-btn" type="button">
            ☰
        </button>

    </div>

</header>


<div id="mobileMenu" class="mobile-menu">

    <a href="/shop">Shop</a>
    <a href="/shop">New Arrivals</a>
    <a href="/shop">Collections</a>
    <a href="/shop">Sale</a>
    <a href="/login">Account</a>
    <a href="/wishlist">Wishlist</a>
    <a href="/cart">Cart</a>

</div>


<main>

    <section class="hero">

        <div class="hero-content">

            <p class="eyebrow">SPRING / SUMMER 2026</p>

            <h1>
                Everyday pieces.
                <br>
                Made better.
            </h1>

            <p>
                Modern menswear designed for everyday life.
                Clean silhouettes, quality fabrics and timeless style.
            </p>

            <a href="/shop" class="btn">
                Shop collection →
            </a>

        </div>

    </section>


    <section class="category-strip">

        <a href="/shop">T-Shirts</a>
        <a href="/shop">Shirts</a>
        <a href="/shop">Trousers</a>
        <a href="/shop">Outerwear</a>
        <a href="/shop">Accessories</a>

    </section>


    <section class="products-section">

        <div class="section-heading">

            <div>
                <p class="eyebrow">THE ESSENTIALS</p>
                <h2>Built for everyday.</h2>
            </div>

            <a href="/shop">
                View all →
            </a>

        </div>


        <div class="product-grid">

            <article class="product-card">

                <div class="product-image">

                    <img
                        src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=900&q=80"
                        alt="Essential Heavy Tee"
                    >

                    <span class="product-badge">
                        BESTSELLER
                    </span>

                    <button
                        class="wishlist"
                        data-name="Essential Heavy Tee"
                        type="button"
                    >
                        ♡
                    </button>

                </div>

                <div class="product-info">

                    <p>T-Shirts</p>

                    <h3>Essential Heavy Tee</h3>

                    <span>₹899</span>

                    <button
                        class="add-cart"
                        data-name="Essential Heavy Tee"
                        data-price="899"
                        type="button"
                    >
                        Add to bag
                    </button>

                </div>

            </article>


            <article class="product-card">

                <div class="product-image">

                    <img
                        src="https://images.unsplash.com/photo-1602810318383-e386cc2a3ccf?auto=format&fit=crop&w=900&q=80"
                        alt="Relaxed Oxford Shirt"
                    >

                    <button
                        class="wishlist"
                        data-name="Relaxed Oxford Shirt"
                        type="button"
                    >
                        ♡
                    </button>

                </div>

                <div class="product-info">

                    <p>Shirts</p>

                    <h3>Relaxed Oxford Shirt</h3>

                    <span>₹1,499</span>

                    <button
                        class="add-cart"
                        data-name="Relaxed Oxford Shirt"
                        data-price="1499"
                        type="button"
                    >
                        Add to bag
                    </button>

                </div>

            </article>


            <article class="product-card">

                <div class="product-image">

                    <img
                        src="https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?auto=format&fit=crop&w=900&q=80"
                        alt="Straight Fit Trousers"
                    >

                    <span class="product-badge">
                        NEW
                    </span>

                    <button
                        class="wishlist"
                        data-name="Straight Fit Trousers"
                        type="button"
                    >
                        ♡
                    </button>

                </div>

                <div class="product-info">

                    <p>Trousers</p>

                    <h3>Straight Fit Trousers</h3>

                    <span>₹1,799</span>

                    <button
                        class="add-cart"
                        data-name="Straight Fit Trousers"
                        data-price="1799"
                        type="button"
                    >
                        Add to bag
                    </button>

                </div>

            </article>


            <article class="product-card">

                <div class="product-image">

                    <img
                        src="https://images.unsplash.com/photo-1598033129183-c4f50c736f10?auto=format&fit=crop&w=900&q=80"
                        alt="Utility Overshirt"
                    >

                    <button
                        class="wishlist"
                        data-name="Utility Overshirt"
                        type="button"
                    >
                        ♡
                    </button>

                </div>

                <div class="product-info">

                    <p>Outerwear</p>

                    <h3>Utility Overshirt</h3>

                    <span>₹2,199</span>

                    <button
                        class="add-cart"
                        data-name="Utility Overshirt"
                        data-price="2199"
                        type="button"
                    >
                        Add to bag
                    </button>

                </div>

            </article>

        </div>

    </section>


    <section class="new-section">

        <div class="new-content">

            <p class="eyebrow">NEW COLLECTION</p>

            <h2>
                Designed to move
                with you.
            </h2>

            <p>
                Relaxed fits, lightweight fabrics and
                versatile colours for the season.
            </p>

            <a href="/shop" class="btn">
                Explore new arrivals →
            </a>

        </div>

    </section>


    <section class="collections">

        <div class="section-heading">

            <div>
                <p class="eyebrow">SHOP BY CATEGORY</p>
                <h2>Find your uniform.</h2>
            </div>

        </div>


        <div class="collection-grid">

            <a href="/shop" class="collection-card">

                <img
                    src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=80"
                    alt="T-Shirts"
                >

                <div>
                    <span>T-Shirts</span>
                    <strong>Shop now →</strong>
                </div>

            </a>


            <a href="/shop" class="collection-card">

                <img
                    src="https://images.unsplash.com/photo-1596755389378-c31d21fd1273?auto=format&fit=crop&w=1000&q=80"
                    alt="Shirts"
                >

                <div>
                    <span>Shirts</span>
                    <strong>Shop now →</strong>
                </div>

            </a>


            <a href="/shop" class="collection-card">

                <img
                    src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=1000&q=80"
                    alt="Trousers"
                >

                <div>
                    <span>Trousers</span>
                    <strong>Shop now →</strong>
                </div>

            </a>

        </div>

    </section>


    <section class="newsletter">

        <p class="eyebrow">STAY IN THE LOOP</p>

        <h2>
            Get the latest from SERIAL.
        </h2>

        <p>
            New drops, exclusive offers and style updates.
        </p>

        <form id="newsletterForm">

            <input
                type="email"
                placeholder="Your email address"
                required
            >

            <button type="submit">
                Subscribe
            </button>

        </form>

    </section>

</main>


<footer class="footer">

    <div class="footer-brand">

        <a href="/" class="logo">SERIAL</a>

        <p>
            Modern menswear for everyday life.
        </p>

    </div>

    <div>

        <h4>Shop</h4>

        <a href="/shop">All products</a>
        <a href="/shop">New arrivals</a>
        <a href="/shop">Sale</a>

    </div>

    <div>

        <h4>Help</h4>

        <a href="/login">Account</a>
        <a href="/cart">Shipping</a>
        <a href="/cart">Returns</a>

    </div>

    <div>

        <h4>Follow</h4>

        <a href="#">Instagram</a>
        <a href="#">Pinterest</a>

    </div>

</footer>


<div id="searchOverlay" class="search-overlay">

    <button id="closeSearch" type="button">
        ×
    </button>

    <div class="search-box">

        <input
            type="text"
            id="searchInput"
            placeholder="Search products..."
        >

        <div id="searchResults"></div>

    </div>

</div>


<aside id="cartPanel" class="cart-panel">

    <div class="cart-panel-header">

        <h3>Your bag</h3>

        <button id="closeCart" type="button">
            ×
        </button>

    </div>

    <div id="cartItems"></div>

    <div class="cart-panel-footer">

        <div>
            <span>Total</span>
            <strong id="cartTotal">₹0</strong>
        </div>

        <a href="/cart" class="btn">
            View bag
        </a>

    </div>

</aside>


<div id="overlay" class="overlay"></div>


<script src="/main.js"></script>

</body>
</html>