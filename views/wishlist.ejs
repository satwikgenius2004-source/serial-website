<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Wishlist — SERIAL</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/style.css">

</head>

<body class="wishlist-page">


<header class="header">

    <a href="/" class="logo">
        SERIAL
    </a>


    <nav class="nav">

        <a href="/shop">
            Shop
        </a>

        <a href="/shop">
            New Arrivals
        </a>

        <a href="/shop">
            Collections
        </a>

        <a href="/shop">
            Sale
        </a>

    </nav>


    <div class="header-actions">

        <a href="/login">
            Account
        </a>

        <a href="/cart">
            Bag (<span id="cartCount">0</span>)
        </a>

    </div>

</header>


<main>


<section class="wishlist-heading">

    <p class="eyebrow">
        SAVED FOR LATER
    </p>

    <h1>
        Your wishlist.
    </h1>

    <p>
        Pieces you've saved for later.
    </p>

</section>


<section
    class="wishlist-grid"
    id="wishlistProducts"
>

    <div class="wishlist-empty">

        <div class="wishlist-icon">
            ♡
        </div>

        <h3>
            Your wishlist is empty
        </h3>

        <p>
            Save your favourite pieces here.
        </p>

        <a href="/shop" class="btn">
            Shop now
        </a>

    </div>

</section>


</main>


<footer class="footer">

    <div class="footer-brand">

        <a href="/" class="logo">
            SERIAL
        </a>

        <p>
            Modern menswear for everyday life.
        </p>

    </div>


    <div>

        <h4>Shop</h4>

        <a href="/shop">
            All products
        </a>

        <a href="/shop">
            New arrivals
        </a>

    </div>


    <div>

        <h4>Account</h4>

        <a href="/login">
            Login
        </a>

        <a href="/register">
            Register
        </a>

    </div>

</footer>


<script src="/main.js"></script>

</body>
</html>